# Скопируйте в .env и при необходимости измените:
#   cp .env.example .env

# Каталог с подпапками «GTO bots data» и «Тестовая база данные популяции».
# Пусто — авто: ./Test base при наличии, иначе корень репозитория.
# Относительные пути — от корня проекта.
TEST_BASE_PATH=

# SQLite-кэш распарсенных рук. Пустое значение — без кэша.
STATS_SQLITE_CACHE=.cache/hands.db

# Число потоков при параллельном чтении .txt (минимум 1). Пусто — min(8, CPU+2).
STATS_LOAD_WORKERS=

# Принудительно игнорировать кэш при чтении (1 / true / yes), затем перезапись.
STATS_SQLITE_CACHE_REBUILD=
